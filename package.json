{
  "name": "antired",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run backend/index.ts",
    "build": "bun build ./backend/index.ts --outdir ./dist",
    "dev": "bun --watch run backend/index.ts",
    "clean": "rm -rf dist",
    "prebuild": "bun run clean",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"backend/**/*.ts\" \"tests/**/*.ts\"",
    "prepare": "husky install"
  },
  "dependencies": {    
    "chalk": "^5.3.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/bun": "^1.0.0",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "bun": "^1.0.0",
    "bun-types": "latest",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "husky": "^8.0.3",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0",
    "@jest/globals": "^29.7.0",
    "jest-environment-node": "^29.7.0"
  },
  "engines": {
    "node": ">=18.0.0"    
  },
  "keywords": [
    "bot-detection",
    "machine-learning",
    "tensorflow",
    "nlp"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/papablack/antired.git"
  },
  "bugs": {
    "url": "https://github.com/papablack/antired/issues"
  },
  "homepage": "https://github.com/papablack/antired#readme",
  "workspaces": [
    "backend",
    "server"
  ]
}
