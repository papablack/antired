{
  "name": "antired_backend",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "npm-run-all --parallel watch:transpile watch:run",
    "watch:run": "nodemon \"./build/rws.server.js\" --watch \"./build\"",
    "watch:transpile": "webpack --config webpack.config.js --watch",
    "build": "webpack --config webpack.config.js --output-path ./build",
    "server": "node build/rws.server.js",
    "hello": "rws hello user=$USER",
    "test": "ts-mocha -r tsconfig-paths/register --config tests/tsconfig.json 'tests/**/*.test.ts'"
   },
  "dependencies": {
    "@tensorflow/tfjs": "^4.15.0",
    "@tensorflow/tfjs-node": "^4.15.0",
    "@tensorflow/tfjs-node-gpu": "^4.15.0",
    "@tensorflow-models/universal-sentence-encoder": "^1.3.3"
  },
  "devDependencies": {
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  },
  "keywords": [
    "bot-detection",
    "machine-learning",
    "tensorflow",
    "nlp"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/papablack/antired.git"
  },
  "bugs": {
    "url": "https://github.com/papablack/antired/issues"
  },
  "homepage": "https://github.com/papablack/antired#readme"
}
